# ============================================================
# Study Notes Automation — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
*.egg-info/
dist/
build/

# ── Secrets & Environment Files ──────────────────────────────
.env
.anthropic_env
.google_env

# ── OS / Editor Junk ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# ── Logs (runtime only, not worth tracking) ────────────────
*.log
logs/

# ── Legacy State File (root-level; the real one is state/assemble-state.json)
.assemble_state.json

# ── Generated Output Files ──────────────────────────────────
*.docx
_prev/
