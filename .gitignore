# ============================================================
# Study Notes Automation — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
*.egg-info/
dist/
build/

# ── Secrets & Environment Files ──────────────────────────────
.env
.anthropic_env
.google_env

# ── OS / Editor Junk ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# ── Logs (runtime only, not worth tracking) ────────────────
*.log
logs/

# ── Legacy State File (root-level; the real one is state/assemble-state.json)
.assemble_state.json

# ── Generated Output Files ──────────────────────────────────
*.docx
_prev/

# ── Local runtime caches (src/claude_cli_subprocess/ + misc skill runners) ──
# .claude/skills/ -- sync_skill_package()'s local extraction of
# templates/*.skill (config.CLAUDE_SKILL_INSTALL_DIR); state/workspace/
# -- per-chapter scratch cwd for the claude CLI subprocess call
# (config.CLAUDE_WORKSPACE_ROOT); .skill-runtime/ and .study-notes/ --
# runtime caches from local ad-hoc skill/CLI test runs. None of these are
# source -- all are regenerated locally, safe to delete anytime.
.claude/
state/workspace/
.skill-runtime/
.study-notes/

# ── LangGraph dev/test run artifacts (checkpoints, debug progress dumps) ────
state/graph-checkpoints/
state/progress/

# ── Runtime state (NEVER commit) ────────────────────────────────────────────
# state/assemble-state.json was previously tracked "for progress preservation"
# and, because it stores the ABSOLUTE source path of every file Stage 1 has
# routed, it published 155 real paths -- the student's name, their coaching
# programme, and a dated record of which lecture happened when. It is pure
# runtime state: load_state() returns {"processed": {}} when the file is
# absent, so a fresh clone just re-routes from scratch. Back it up outside
# git if you want it preserved; do not re-add it here.
# (No .gitkeep negation here on purpose -- git cannot re-include a file whose
# parent directory is excluded, and the code mkdirs state/ on demand anyway.)
state/

# ── Local PII patterns for githooks/pre-commit (see .pii-patterns.example) ──
# Holds the real names the hook blocks, so it must never be committed itself.
.pii-patterns
